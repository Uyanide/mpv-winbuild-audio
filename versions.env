# Single source of truth for every upstream input of this build.
#
# To bump a component:
#   1. change its *_VERSION
#   2. refresh its *_SHA256   (./tools/refresh-sums.sh rewrites this file)
#   3. reset BUILD_REV to 1 when MPV_VERSION changed, otherwise increment it
#
# Everything here is copied verbatim into BUILDINFO.txt of the release artifact,
# so a release always names the exact bytes it was built from.

MPV_VERSION=0.41.0
MPV_SHA256=ee21092a5ee427353392360929dc64645c54479aefdb5babc5cfbb5fad626209

# mpv 0.41.0 requires libavcodec >= 60.31.102 (FFmpeg 6.1). A major FFmpeg bump is
# the one upgrade worth being nervous about, since each drops deprecated APIs -- but
# mpv 0.41.0 builds against 9.x without a single deprecation warning and the wine
# matrix passes, so there is nothing to hold back for. If a future major does break
# mpv, it breaks as a compile error here rather than as something that ships.
FFMPEG_VERSION=9.0.1
FFMPEG_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635

LIBASS_VERSION=0.17.5
LIBASS_SHA256=2dca25c0e0c837ddf00b52011b3f82cac1e4ddd3ad018227806b0c2288864acc

LIBPLACEBO_VERSION=7.360.1
LIBPLACEBO_SHA256=d05fdf90bea2f629eaa2d115e909fd356388ac639e54f77b87a018a6d76224bd

# Headers only, and only so that libplacebo's src/vulkan/stubs.c compiles: that
# translation unit is built even with -Dvulkan=disabled, and libplacebo's public
# vulkan.h includes <vulkan/vulkan.h>. Nothing is linked against Vulkan and no
# vulkan-1.dll import results -- verify/verify.sh asserts exactly that.
# The value is libplacebo's own submodule commit, so it follows LIBPLACEBO_VERSION.
VULKAN_HEADERS_VERSION=450bd2232225d6c7728a4108055ac2e37cef6475
VULKAN_HEADERS_SHA256=26df9841c30806a994e2fdf42f7c87bcb1ced9db9a06033469123939fb3fa075

FREETYPE_VERSION=2.14.3
FREETYPE_SHA256=36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f

# libass 0.17.5 dropped the --disable-harfbuzz switch: HarfBuzz (>= 1.2.3) is now
# an unconditional dependency, so it has to be cross-built too. It is the only C++
# library in the chain, which is why the link uses -static-libstdc++.
HARFBUZZ_VERSION=14.4.0
HARFBUZZ_SHA256=2357ed966c6ced7bfa720b0640c0231065af01158fbea215093ffa15aed44371

FRIBIDI_VERSION=1.0.16
FRIBIDI_SHA256=1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c

ZLIB_VERSION=1.3.2
ZLIB_SHA256=d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3

# Bumped for a rebuild that keeps MPV_VERSION but changes anything else.
BUILD_REV=2
